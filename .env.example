# Copy to .env and fill in. Never commit .env.

# Public hostname for the portal. "localhost" for a quick local test.
DEV_DOMAIN=dev.wazzahappenin.com

# Shared secret between portal and mcp (internal only). Generate with:
#   openssl rand -hex 32
MCP_API_KEY=

# Signs tester session cookies. openssl rand -hex 32
SESSION_SECRET=

# --- Tester sign-in ---
# oidc   = OAuth 2.0 / OpenID Connect single sign-on (use this when deployed)
# invite = shared invite codes (quick local testing only)
AUTH_MODE=oidc

# Register an app with your provider, using redirect URI
#   https://<DEV_DOMAIN>/auth/callback
# Issuer examples:
#   Microsoft Entra (one tenant): https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google:                       https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Who may sign in. Comma-separated; leave both empty to allow anyone the provider authenticates.
OIDC_ALLOWED_DOMAINS=
OIDC_ALLOWED_EMAILS=
# Only needed if the portal is reached somewhere other than https://<DEV_DOMAIN>.
# PUBLIC_URL=

# Comma-separated codes, used only when AUTH_MODE=invite.
INVITE_CODES=

# Where Ollama lives. Leave as-is with --profile ollama; otherwise point at the
# existing Ollama machine, e.g. http://192.168.1.50:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
# Must match the embed model. nomic-embed-text = 768.
QDRANT_VECTOR_SIZE=768

INSTANCE_TTL_DAYS=14
MAX_INSTANCES_PER_TESTER=3
MAX_DOCS_PER_INSTANCE=50
MAX_UPLOAD_MB=20
